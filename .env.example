# ==================================================
# InterviewSprint AI - Environment Variables
# ==================================================
# Copy this file to .env.local and fill in your values
# cp .env.example .env.local

# ─── Database (Neon PostgreSQL) ───────────────────
# Get your connection string from https://neon.tech
DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"

# ─── Auth.js / NextAuth ──────────────────────────
# Generate with: openssl rand -base64 32
AUTH_SECRET="your-auth-secret-min-32-characters-here"

# Production: set to your Vercel domain
# Development: http://localhost:3000
AUTH_URL="http://localhost:3000"

# ─── Google OAuth ────────────────────────────────
# Get from https://console.cloud.google.com/apis/credentials
AUTH_GOOGLE_ID="your-google-client-id.apps.googleusercontent.com"
AUTH_GOOGLE_SECRET="your-google-client-secret"

# ─── OpenAI ──────────────────────────────────────
# Get from https://platform.openai.com/api-keys
OPENAI_API_KEY="sk-your-openai-api-key"

# ─── Optional ──────────────────────────────────────
# Model for JD analysis (default gpt-4.1-mini)
OPENAI_MODEL="gpt-4.1-mini"
# Java analytics service (analytics-service/). Leave empty to use the built-in engine.
ANALYTICS_SERVICE_URL=""
ANALYTICS_SERVICE_TOKEN=""
# Public read-only demo account (defaults shown)
NEXT_PUBLIC_DEMO_EMAIL="demo@interviewsprint.dev"
NEXT_PUBLIC_DEMO_PASSWORD="demo-sprint-2026"
