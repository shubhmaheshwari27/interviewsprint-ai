{
  "manifest_version": 3,
  "name": "InterviewSprint – Save this job",
  "short_name": "InterviewSprint",
  "version": "1.0.0",
  "description": "Save the job you are viewing (LinkedIn, Naukri, Instahyre, Wellfound, Indeed, company sites) to InterviewSprint AI with one click, with a skill match score.",
  "action": {
    "default_popup": "popup.html",
    "default_title": "Save this job to InterviewSprint",
    "default_icon": { "16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png" }
  },
  "icons": { "16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png" },
  "permissions": ["activeTab", "scripting", "storage"],
  "host_permissions": ["https://interviewsprint-ai.vercel.app/*", "http://localhost:3000/*"]
}
